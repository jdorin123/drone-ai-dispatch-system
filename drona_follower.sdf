<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="drona_follower">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>4.58</mass>
        <inertia>
          <ixx>0.085</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.085</iyy><iyz>0.0</iyz><izz>0.155</izz>
        </inertia>
      </inertial>
      
      <collision name="collision"><geometry><box><size>0.45 0.45 0.20</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.45 0.45 0.20</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <gravity>false</gravity>

      <sensor type="ray" name="livox_3d_sensor">
        <pose>0 0 0.12 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical>
          </scan>
          <range><min>0.1</min><max>40.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="gazebo_ros_laser_controller_follower" filename="libgazebo_ros_velodyne_laser.so">
          <frameName>velodyne_link_follower</frameName>
          <organize_cloud>false</organize_cloud>
          <min_range>0.4</min_range>
          <max_range>20.0</max_range>
          <gaussianNoise>0.008</gaussianNoise>
        </plugin>
      </sensor>

      <sensor type="ray" name="lidar_2d_follower">
        <pose>0 0 0.18 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>40</update_rate>
        <ray>
          <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-1.5707</min_angle><max_angle>1.5707</max_angle></horizontal></scan>
          <range><min>0.2</min><max>5.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="gazebo_ros_laser_controller_follower" filename="libgazebo_ros_laser.so">
          <topicName>scan_follower</topicName>
          <frameName>base_link</frameName>
        </plugin>
      </sensor>

      <sensor type="ray" name="altimetru_1d_follower">
        <pose>0 0 -0.11 0 1.5707 0</pose>
        <visualize>false</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>-0.001</min_angle><max_angle>0.001</max_angle></horizontal></scan>
          <range><min>0.05</min><max>14.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="gazebo_ros_range_controller_follower" filename="libgazebo_ros_range.so">
          <topicName>altitudine_sol_follower</topicName>
          <frameName>base_link</frameName>
          <radiation>ultrasound</radiation><fov>0.05</fov>
        </plugin>
      </sensor>
    </link>

    <link name="camera_link_follower">
      <gravity>false</gravity>
      <pose>0.18 0 0.05 0 0 0</pose>
      <visual name="camera_visual_follower"><geometry><box><size>0.03 0.12 0.03</size></box></geometry><material><ambient>0.0 0.0 0.8 1</ambient><diffuse>0.0 0.0 0.8 1</diffuse></material></visual>
      <sensor type="depth" name="follower_camera_sensor">
        <update_rate>30.0</update_rate>
        <camera name="head">
          <horizontal_fov>1.25664</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>30.0</far></clip>
        </camera>
        <plugin name="camera_controller_follower" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn><updateRate>30.0</updateRate>
          <cameraName>follower_cam</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_link_follower</frameName>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint_follower" type="fixed"><parent>base_link</parent><child>camera_link_follower</child></joint>

    <link name="aruco_marker_link_follower">
      <pose>-0.23 0 0.05 0 1.5707 0</pose>
      <gravity>false</gravity>
      <visual name="aruco_visual_follower">
        <geometry><box><size>0.15 0.15 0.001</size></box></geometry>
      </visual>
    </link>
    <joint name="aruco_joint_follower" type="fixed"><parent>base_link</parent><child>aruco_marker_link_follower</child></joint>

    <plugin name="object_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel_follower</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>50.0</odometryRate>
      <robotBaseFrame>base_link</robotBaseFrame>
    </plugin>
  </model>
</sdf>