<launch>
    <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom 100" />
    
    <node pkg="tf" type="static_transform_publisher" name="velodyne_tf" args="0 0 0.1 0 0 0 base_link velodyne_link 100" />

    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
        <param name="resolution" value="0.2" /> 
        <param name="frame_id" type="string" value="map" />
        <param name="sensor_model/max_range" value="20.0" /> 
        <remap from="cloud_in" to="/velodyne_points" />
    </node>

    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="adaptor_2d">
        <remap from="cloud_in" to="/velodyne_points" />
        <remap from="scan" to="/scan" />
        <param name="target_frame" value="velodyne_link" />
        <param name="min_height" value="-0.5" /> <param name="max_height" value="0.5" />  
        <param name="angle_min" value="-3.14159" /> <param name="angle_max" value="3.14159" />
        <param name="range_min" value="0.4" /> <param name="range_max" value="15.0" />
    </node>
</launch>